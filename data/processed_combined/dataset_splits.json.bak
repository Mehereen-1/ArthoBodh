    {
      "folder": "Word 6",
      "target_word": "কাপ",
      "sense_num": 2,
      "sense_label": 1,
      "sense_def": "কপটতা",
      "text": "এক অনুষ্ঠানে বারাক ওবামা মেলিন্ডা গেটস ও গেটসএই সপ্তাহে জাতিসংঘের ৭২তম সাধারণ সম্মেলন উপলক্ষে বিশ্বের বিভিন্ন দেশের নেতারা নিউইয়র্কে উপস্থিত হয়েছিলেন। সাধারণত সাধারণ অধিবেশনে পৃথিবীর বিভিন্ন গুরুত্বপূর্ণ বিষয়ে নীতিমালা প্রণয়ন করা হয়। এবারও অনেক সভা হয়েছ, চমৎকার সব পার্টি হয়েছে, নেতাদের বক্তৃতায় ধ্বনিত হয়েছে কীভাবে পৃথিবীকে আরও বাসযোগ্য, যুদ্ধ, দরিদ্র, ক্ষুধা এবং জরামুক্ত করা যায়। কিন্তু নেতাদের এসব বাণী ও তাঁদের কাজের মাঝে আছে একধরনের কপটতা। এ বছর বিশ্বের বেশ কিছু নবাগত নেতা উপস্থিত ছিলেন।",
      "source_dataset": "kaggle_raw",
      "num_senses_for_word": 3,
      "split": "train"
    },
